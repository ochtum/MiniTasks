@inherits LayoutComponentBase

<a class="skip-link" href="#main">本文へ移動</a>
<header class="site-header">
    <a class="brand" href="/" aria-label="MiniTasks ホーム"><span class="brand-mark" aria-hidden="true">✓</span> MiniTasks</a>
    <AuthorizeView>
        <Authorized Context="auth">
            <div class="account">
                <span class="account-email">@auth.User.Identity?.Name</span>
                <form method="post" action="/account/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <button class="button ghost" type="submit">ログアウト</button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized><span class="header-note">小さく始めて、一歩ずつ。</span></NotAuthorized>
    </AuthorizeView>
</header>
<main id="main" class="page-shell">@Body</main>
<footer class="site-footer"><span>MiniTasks</span><span>あなたの次の一歩を、ここに。</span></footer>
<div id="blazor-error-ui" role="alert">
    接続に問題が発生しました。<a href="" class="reload">画面を再読込</a>してください。
    <button class="dismiss" type="button" aria-label="閉じる">×</button>
</div>
